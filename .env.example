# 복사해서 .env 로 만들고 값을 채운다 (cp .env.example .env). .env 는 .gitignore 에 들어 있다.
# 모두 서버 전용 변수다. 절대 VITE_ 로 시작하게 만들지 말 것 (브라우저 번들에 노출됨, 개발 서버가 막아 준다).
# Vercel에서는 같은 이름으로 Project Settings → Environment Variables 에 넣는다.

# ── AI (lib/llm.js 한 곳에서만 호출) ─────────────────────────────
# openai | gemini | anthropic | mock   (mock 이면 키 없이 동작하고 화면에 "예시 모드"가 표시된다)
LLM_PROVIDER=openai

# OpenAI (chat/completions)
OPENAI_API_KEY=
# 선택: 모델 이름. 비우면 gpt-4o-mini. 계정에서 쓸 수 있는 모델로 바꿔도 된다.
OPENAI_MODEL=
# 선택: 프록시/호환 서버 주소 (끝에 /v1 까지). 비우면 https://api.openai.com/v1
OPENAI_BASE_URL=

# Gemini (OpenAI 호환 엔드포인트)
GEMINI_API_KEY=
GEMINI_MODEL=

# Anthropic (messages)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── DB (Neon PostgreSQL, "pooled" 연결 주소) ─────────────────────
# 없으면 확정 기록을 저장하지 않고(recorded:false), 요청 횟수는 메모리로 센다 (로컬용).
# 테이블 만들기: npm run db:setup
DATABASE_URL=

# ───────────────────────────────────────────────────────────────
# [공공데이터 API — 지금은 자리만. 연결은 다음 단계 (README "3순위" 참고)]
# 가격은 하루 1회 모아 DB에 저장하고, 화면은 저장값 + 출처 + 기준 날짜만 보여준다. 공공 API를 요청마다 부르지 않는다.

# 식약처 조리식품 레시피 DB (COOKRCP01).
# 뽑힌 재료가 들어간 레시피를 AI 참고 자료로 주고, 결과 화면에 제목·출처를 표시한다.
FOODSAFETY_API_KEY=

# KAMIS 농산물 소매가격. 채소·과일 재료의 평균 가격.
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 한국소비자원 생필품 가격 정보(XML). 가공식품 재료의 평균 가격.
PRICE_API_KEY=
