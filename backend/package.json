{
  "name": "diet-roulette-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "보조바퀴 백엔드: /api 서버 (로컬은 server.js, 배포는 Vercel 서버리스 함수)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test \"test/*.test.js\"",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js",
    "data:check": "node --env-file-if-exists=.env scripts/check-data.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  }
}
